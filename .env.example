# API runtime
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/investment_tracker

# development | test | production. No default: the API refuses to boot without it.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Seconds /readyz waits for the database before answering 503.
# READYZ_TIMEOUT_SECONDS=2.0

# Compose (local dev only, dummy values)
POSTGRES_VERSION=17
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=investment_tracker

# Public https origin of the web app. Required in production; builds the Google
# redirect URI and the links inside verification and reset emails.
WEB_BASE_URL=http://localhost:5173

# Access token signing. Ed25519 private key, unencrypted PEM. Required in production;
# outside production an ephemeral key is generated on each boot.
# JWT_PRIVATE_KEY=
# JWT_ISSUER=investment-tracker
# JWT_AUDIENCE=investment-tracker-web

# Google sign-in (OIDC). Leave both unset to disable it.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Gmail API email sender (production). Set all four or none; blank counts as unset.
# Production refuses to boot without an email sender (these four, or a TLS SMTP_URL).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# SMTP email sender, alternative to Gmail: smtp://, smtp+starttls:// or smtps://
# (TLS only in production). Keep it commented when unused: blank fails validation.
# SMTP_URL=
# From address for SMTP; with Gmail only its display name is used.
# EMAIL_FROM=Investment Tracker <no-reply@investment-tracker.local>

# Shared secret the Vercel proxy sends in x-proxy-secret so the API trusts the
# client IP it forwards. Min 32 chars, required in production, same value in
# Vercel (Production and Preview). Keep it commented locally: blank fails validation.
# PROXY_SHARED_SECRET=